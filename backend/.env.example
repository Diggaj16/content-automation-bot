# Postgres (self-hosted, replaces Supabase)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/contentautomation

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Supabase — legacy, only needed for scripts/migrate_from_supabase.py
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gemini embeddings (falls back to local fastembed if unset)
GOOGLE_API_KEY=

# Tavily web search (falls back to DuckDuckGo if unset)
TAVILY_API_KEY=

# API security — set to require X-Api-Key header on all backend routes.
# If set, the frontend's BACKEND_API_KEY (frontend/.env.local) MUST match this
# value exactly, or every backend request from the frontend proxy will 403.
API_KEY=

# Redis (local)
REDIS_URL=redis://localhost:6379

# Slack (optional — for cost alerts)
SLACK_WEBHOOK_URL=

# Cost alerts
DAILY_COST_ALERT_USD=5.0

# Models
CLAUDE_MODEL_HEAVY=claude-sonnet-4-6
CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001
ORCHESTRATOR_MODEL=claude-sonnet-4-6

# Research agent
ARTICLE_MIN_WORDS=400
ARTICLE_MAX_AGE_DAYS=7
DEFAULT_PRE_SCORE_THRESHOLD=4.0

# Site health
SITE_FAILURE_PAUSE_THRESHOLD=5

# Analytics — off by default. metrics_fetcher.py still returns random stub data,
# so there's nothing real to measure until platform posting (poster.py) is real.
ANALYTICS_ENABLED=false
