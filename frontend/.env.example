# Base URL the browser uses to reach the backend directly (if not proxying).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL the Next.js server-side proxy (app/api/proxy/[...path]/route.ts) uses
# to reach the backend.
BACKEND_URL=http://localhost:8000

# Shared secret sent as the X-Api-Key header on every proxied request.
# Must exactly match API_KEY in backend/.env, or the backend will reject every
# request from this app with 403. Leave both unset to disable the guard entirely.
BACKEND_API_KEY=

# Optional HTTP Basic Auth gate in front of the whole app (see proxy.ts).
# Enforced only when both are set. Leave unset for local development.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
